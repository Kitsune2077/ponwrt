From: Kitsune <km2077@foxmail.com>
Subject: [PATCH] net: airoha: offload bridge ports via switchdev

Register the airoha netdevs as switchdev bridge ports and feed the bridge
forwarding database into the PPE offload table added by the previous patch.

The netdev that joins the bridge is the bridge port itself, so
switchdev_bridge_port_offload() gets the same device as bridge port and as
offloaded port when the upper link is a bridge. FDB add/delete events are
broadcast on the global switchdev notifier chain, while the per-port
notifier blocks passed to switchdev_bridge_port_offload() are only used by
the bridge to replay its state, so both are registered for the same blocks.

The offload is best effort: switchdev_bridge_port_offload() currently fails
with -EOPNOTSUPP because the netdev has no port parent id (no devlink switch
port and no ndo_get_port_parent_id), and the bridge join must not fail for
that. FDB events keep arriving on the global chain, so the forwarding
database is still tracked and bridged flows are still offloaded.

Signed-off-by: Kitsune <km2077@foxmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -16,6 +16,7 @@
 #include <net/dst_metadata.h>
 #include <net/page_pool/helpers.h>
 #include <net/pkt_cls.h>
+#include <net/switchdev.h>
 #include <uapi/linux/ppp_defs.h>
 
 #include "airoha_regs.h"
@@ -3998,6 +3999,145 @@ static const struct net_device_ops airoha_netdev_ops = {
 	.ndo_setup_tc		= airoha_dev_tc_setup,
 };
 
+/* Bridge port offload.
+ *
+ * The airoha netdev is the bridge port itself (the GDM netdevs are members
+ * of br-lan), so switchdev_bridge_port_offload() receives the same device as
+ * bridge port and as offloaded port. The notifier blocks are also registered
+ * on the global switchdev chains: the bridge only replays its state to the
+ * per-port blocks, runtime FDB events are broadcast to every registered
+ * notifier.
+ */
+static bool airoha_netdev_is_offloadable(const struct net_device *netdev)
+{
+	return netdev->netdev_ops == &airoha_netdev_ops;
+}
+
+static int airoha_switchdev_event(struct notifier_block *unused,
+				  unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_fdb_info *fdb_info = ptr;
+	struct net_device *port_dev = switchdev_notifier_info_to_dev(ptr);
+	struct airoha_gdm_dev *gdm;
+
+	switch (event) {
+	case SWITCHDEV_FDB_ADD_TO_DEVICE:
+	case SWITCHDEV_FDB_DEL_TO_DEVICE:
+		/* info.dev is the bridge port the address was learned on, i.e. the
+		 * egress port for frames addressed to it. Entries owned by the
+		 * bridge itself are not forwarded in hardware.
+		 */
+		if (!airoha_netdev_is_offloadable(port_dev) || fdb_info->is_local)
+			return NOTIFY_DONE;
+
+		gdm = netdev_priv(port_dev);
+		if (!airoha_is_valid_gdm_dev(gdm->eth, gdm))
+			return NOTIFY_DONE;
+
+		airoha_ppe_bridge_fdb_update(gdm->eth, fdb_info->addr,
+					     fdb_info->vid, port_dev,
+					     event == SWITCHDEV_FDB_ADD_TO_DEVICE);
+		return NOTIFY_DONE;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block airoha_switchdev_nb = {
+	.notifier_call = airoha_switchdev_event,
+};
+
+static int airoha_switchdev_blocking_event(struct notifier_block *unused,
+					   unsigned long event, void *ptr)
+{
+	switch (event) {
+	case SWITCHDEV_PORT_OBJ_ADD:
+	case SWITCHDEV_PORT_OBJ_DEL:
+		/* TODO: bridge VLAN membership (tag push/pop) and MDB entries
+		 * (multicast) are per-port objects delivered on this chain. Both
+		 * are left to the software bridge by this version, which is why
+		 * only untagged unicast destinations are offloaded.
+		 */
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block airoha_switchdev_blocking_nb = {
+	.notifier_call = airoha_switchdev_blocking_event,
+};
+
+static void airoha_bridge_port_offload(struct net_device *netdev,
+				       struct netlink_ext_ack *extack)
+{
+	struct airoha_gdm_dev *gdm = netdev_priv(netdev);
+	int err;
+
+	/* Let the bridge assign a hardware domain to this port and replay its
+	 * current FDB (and VLAN/MDB) state to the notifier blocks above.
+	 */
+	err = switchdev_bridge_port_offload(netdev, netdev, NULL,
+					    &airoha_switchdev_nb,
+					    &airoha_switchdev_blocking_nb,
+					    false, extack);
+	if (err) {
+		/* Offload is best effort, never fail the bridge join. The netdev
+		 * has no port parent id (devlink switch port or
+		 * ndo_get_port_parent_id), so this currently returns -EOPNOTSUPP:
+		 * the bridge will not know the port is offloaded, but FDB events
+		 * keep being delivered on the global switchdev notifier chain.
+		 */
+		dev_info(gdm->eth->dev,
+			 "%s: bridge port offload unavailable: %d\n",
+			 netdev->name, err);
+	}
+}
+
+static void airoha_bridge_port_unoffload(struct net_device *netdev)
+{
+	switchdev_bridge_port_unoffload(netdev, NULL, &airoha_switchdev_nb,
+					&airoha_switchdev_blocking_nb);
+}
+
+static int airoha_netdevice_event(struct notifier_block *unused,
+				  unsigned long event, void *ptr)
+{
+	struct net_device *netdev = netdev_notifier_info_to_dev(ptr);
+	struct netdev_notifier_changeupper_info *info = ptr;
+
+	if (!airoha_netdev_is_offloadable(netdev))
+		return NOTIFY_DONE;
+
+	switch (event) {
+	case NETDEV_PRECHANGEUPPER:
+		/* The bridge only accepts SWITCHDEV_BRPORT_UNOFFLOADED while the
+		 * netdev is still a bridge port, so release the offload before
+		 * the upper link is removed.
+		 */
+		if (!info->linking && netif_is_bridge_master(info->upper_dev))
+			airoha_bridge_port_unoffload(netdev);
+		break;
+	case NETDEV_CHANGEUPPER:
+		if (info->linking && netif_is_bridge_master(info->upper_dev))
+			airoha_bridge_port_offload(netdev,
+						   netdev_notifier_info_to_extack(&info->info));
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block airoha_netdevice_nb = {
+	.notifier_call = airoha_netdevice_event,
+};
+
 int airoha_eth_pon_xmit_control(
 	struct net_device *pon_netdev, struct net_device *control_netdev,
 	struct sk_buff *skb, const struct airoha_pon_ctrl_tx_info *info)
@@ -4711,6 +4851,17 @@ static int airoha_probe(struct platform_device *pdev)
 	if (err)
 		goto error_napi_stop;
 
+	err = register_netdevice_notifier(&airoha_netdevice_nb);
+	if (err)
+		goto error_napi_stop;
+
+	/* FDB notifications are sent to the global switchdev notifier chain,
+	 * the per-port blocks passed to switchdev_bridge_port_offload() are
+	 * only used by the bridge to replay its state.
+	 */
+	register_switchdev_notifier(&airoha_switchdev_nb);
+	register_switchdev_blocking_notifier(&airoha_switchdev_blocking_nb);
+
 	return 0;
 
 error_napi_stop:
@@ -4755,6 +4906,10 @@ static void airoha_remove(struct platform_device *pdev)
 	struct airoha_eth *eth = platform_get_drvdata(pdev);
 	int i;
 
+	unregister_switchdev_blocking_notifier(&airoha_switchdev_blocking_nb);
+	unregister_switchdev_notifier(&airoha_switchdev_nb);
+	unregister_netdevice_notifier(&airoha_netdevice_nb);
+
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
 		airoha_qdma_stop_napi(&eth->qdma[i]);
 		airoha_qdma_tx_cleanup(&eth->qdma[i]);
