From: Kitsune <km2077@foxmail.com>
Subject: [PATCH] net: airoha: ppe: add a bridge FDB offload table

The PPE can only forward bridged traffic on its own once it owns an L2B
entry for the (source MAC, destination MAC) pair of a flow, and nothing in
the driver installs such entries on behalf of the Linux bridge: the
l2_flows table is filled by the netfilter offload path only, so every other
bridged frame - PPPoE and other non-IP L2 traffic in particular - keeps
being forwarded by the software bridge.

Track the bridge forwarding database instead. An FDB entry only carries
"destination MAC (+VLAN) -> egress port" while the PPE hash is keyed on the
whole (source MAC, destination MAC) pair, so keep the FDB view in its own
table and resolve the missing source MAC from the first frame of a flow in
the RX slow path, reusing the existing l2_flows machinery to build and
commit the per-flow FOE entry.

Removing a destination drops the flows promoted from it. Frames that need a
VLAN tag rewrite, multicast/broadcast and unknown unicast destinations stay
in the software bridge: tag push/pop on the AN7581 L2B entry and multicast
replication are not implemented yet.

Signed-off-by: Kitsune <km2077@foxmail.com>
---
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index c3e5a98f7..5e654f477 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -560,6 +560,14 @@ struct airoha_flow_table_entry {
 	struct hlist_node l2_subflow_node; /* PPE L2 subflow entry */
 	u32 hash;
 
+	/* Bridge FDB entry that promoted this L2 flow, see
+	 * airoha_ppe_bridge_fdb_update(). The FDB path owns the flows it
+	 * promoted and has to invalidate their FOE entries as soon as the bridge
+	 * removes the destination, without being able to walk ppe->l2_flows
+	 * from the (possibly atomic) FDB event.
+	 */
+	struct list_head fdb_node;
+
 	struct airoha_foe_stats64 stats;
 	enum airoha_flow_entry_type type;
 
@@ -576,6 +584,30 @@ struct airoha_flow_table_entry {
 	struct airoha_foe_entry data;
 };
 
+/* Bridge FDB offload key. The software bridge only tracks the destination
+ * MAC and the VLAN, while the PPE L2B/FOE hash is keyed on the whole
+ * (source MAC, destination MAC) pair of a flow, so the source MAC is
+ * resolved from the first frame of each flow in the RX slow path, see
+ * airoha_ppe_bridge_fdb_promote().
+ */
+struct airoha_fdb_key {
+	u8 addr[ETH_ALEN];
+	u16 vid;
+};
+
+struct airoha_fdb_entry {
+	struct rhash_head node;
+
+	/* All bridge FDB entries, for teardown. */
+	struct list_head list;
+
+	/* L2 flows promoted from this entry (airoha_flow_table_entry). */
+	struct list_head flows;
+
+	struct airoha_fdb_key key;
+	struct net_device *egress;
+};
+
 struct airoha_wdma_info {
 	u8 idx;
 	u8 queue;
@@ -717,6 +749,25 @@ struct airoha_ppe {
 
 	struct rhashtable l2_flows;
 
+	/* Bridge FDB offload table, keyed on destination MAC + VLAN. */
+	struct rhashtable fdb_table;
+	struct list_head fdb_list;
+
+	/* On-demand NPU attach for the bridge FDB path. The attach routine
+	 * sleeps and may load the airoha-npu module, so it cannot run in the RX
+	 * slow path; see airoha_ppe_bridge_fdb_schedule_npu_attach().
+	 */
+	struct work_struct npu_attach_work;
+	unsigned long npu_attach_state;
+
+	/* Bridge FDB offload counters. */
+	struct {
+		unsigned long promoted;     /* L2 flows promoted from the FDB */
+		unsigned long no_entry;     /* no FDB entry for the destination */
+		unsigned long vlan_rewrite; /* tag push/pop needed, see promote */
+		unsigned long no_npu;       /* NPU not configured, promote skipped */
+	} fdb_stats;
+
 	struct hlist_head *foe_flow;
 	u16 *foe_check_time;
 
@@ -840,6 +891,8 @@ airoha_qdma_deref(struct airoha_gdm_dev *dev)
 void airoha_ppe_set_mtu(struct airoha_gdm_dev *dev);
 void airoha_ppe_set_cpu_port(struct airoha_gdm_dev *dev, u8 ppe_id, u8 fport);
 void airoha_ppe_remove_egress_flows(struct airoha_gdm_dev *dev);
+int airoha_ppe_bridge_fdb_update(struct airoha_eth *eth, const u8 *addr,
+				 u16 vid, struct net_device *egress, bool add);
 bool airoha_ppe_is_enabled(struct airoha_eth *eth, int index);
 void airoha_ppe_check_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 			  u16 hash, bool rx_wlan);
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 20842789c..a215a64f6 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -9,6 +9,7 @@
 #include <linux/ipv6.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/if_bridge.h>
 #include <linux/rhashtable.h>
 #include <net/ipv6.h>
 #include <linux/if_vlan.h>
@@ -22,6 +23,11 @@
  * configuration.
  */
 DEFINE_MUTEX(flow_offload_mutex);
+
+/* airoha_ppe::npu_attach_state bits. */
+#define AIROHA_PPE_NPU_ATTACH_SCHEDULED	0
+#define AIROHA_PPE_NPU_ATTACH_DISABLED	1
+
 static DEFINE_SPINLOCK(ppe_lock);
 
 static const struct rhashtable_params airoha_flow_table_params = {
@@ -38,6 +44,13 @@ static const struct rhashtable_params airoha_l2_flow_table_params = {
 	.automatic_shrinking = true,
 };
 
+static const struct rhashtable_params airoha_fdb_table_params = {
+	.head_offset = offsetof(struct airoha_fdb_entry, node),
+	.key_offset = offsetof(struct airoha_fdb_entry, key),
+	.key_len = sizeof(struct airoha_fdb_key),
+	.automatic_shrinking = true,
+};
+
 static int airoha_ppe_get_num_stats_entries(struct airoha_ppe *ppe)
 {
 	if (!IS_ENABLED(CONFIG_NET_AIROHA_FLOW_STATS))
@@ -1008,7 +1021,7 @@ airoha_ppe_foe_commit_subflow_entry(struct airoha_ppe *ppe,
 	u32 mask = AIROHA_FOE_IB1_BIND_PACKET_TYPE | AIROHA_FOE_IB1_BIND_UDP;
 	struct airoha_foe_entry *hwe_p, hwe;
 	struct airoha_flow_table_entry *f;
-	int type;
+	int err, type;
 
 	hwe_p = airoha_ppe_foe_get_entry_locked(ppe, hash);
 	if (!hwe_p)
@@ -1054,19 +1067,37 @@ airoha_ppe_foe_commit_subflow_entry(struct airoha_ppe *ppe,
 
 	hwe.bridge.data = e->data.bridge.data;
 commit:
-	airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
+	err = airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
+	if (err) {
+		/* Do not leave a software subflow behind that the hardware never
+		 * learned: callers must only count a promotion that reached the
+		 * PPE.
+		 */
+		hlist_del_init(&f->l2_subflow_node);
+		kfree(f);
+	}
 
-	return 0;
+	return err;
 }
 
-static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
-					struct sk_buff *skb,
-					u32 hash, bool rx_wlan)
+/* Outcome of the RX slow path for one PPE hash slot. */
+enum airoha_foe_slowpath {
+	/* No L2B entry, or an entry this driver does not handle. */
+	AIROHA_FOE_SLOWPATH_NONE,
+	/* A FOE entry was committed for this hash. */
+	AIROHA_FOE_SLOWPATH_HANDLED,
+	/* Unbound native L2B entry: the bridge FDB may know the destination. */
+	AIROHA_FOE_SLOWPATH_BRIDGE,
+};
+
+static enum airoha_foe_slowpath
+airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe, struct sk_buff *skb,
+			    u32 hash, bool rx_wlan)
 {
 	struct airoha_flow_table_entry *e;
 	struct airoha_foe_bridge br = {};
 	struct airoha_foe_entry *hwe;
-	bool commit_done = false;
+	bool commit_done = false, bridge_miss = false;
 	struct hlist_node *n;
 	u32 index, state;
 
@@ -1083,8 +1114,10 @@ static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
 	/* Native L2B uses its learned key, not an IPv4/L4 software hash bucket. */
 	if (airoha_is_7581(ppe->eth) &&
 	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
-	    PPE_PKT_TYPE_BRIDGE)
+	    PPE_PKT_TYPE_BRIDGE) {
+		bridge_miss = true;
 		goto l2_lookup;
+	}
 
 	index = airoha_ppe_foe_get_entry_hash(ppe, hwe);
 	hlist_for_each_entry_safe(e, n, &ppe->foe_flow[index], list) {
@@ -1112,10 +1145,20 @@ static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
 				   airoha_l2_flow_table_params);
-	if (e)
+	if (e) {
 		airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, rx_wlan);
+		commit_done = true;
+	}
 unlock:
 	spin_unlock_bh(&ppe_lock);
+
+	if (commit_done)
+		return AIROHA_FOE_SLOWPATH_HANDLED;
+
+	if (bridge_miss)
+		return AIROHA_FOE_SLOWPATH_BRIDGE;
+
+	return AIROHA_FOE_SLOWPATH_NONE;
 }
 
 static int
@@ -1133,9 +1176,15 @@ airoha_ppe_foe_l2_flow_commit_entry(struct airoha_ppe *ppe,
 	if (IS_ERR(prev))
 		return PTR_ERR(prev);
 
-	return rhashtable_replace_fast(&ppe->l2_flows, &prev->l2_node,
-				       &e->l2_node,
-				       airoha_l2_flow_table_params);
+	/* Never replace an entry that is already installed for this
+	 * (source MAC, destination MAC, VLAN) triple: it can belong to the
+	 * netfilter offload path, and dropping it here would free an object
+	 * that path still owns. The callers that can hit this race look the
+	 * existing entry up first and reuse it, see
+	 * airoha_ppe_bridge_fdb_promote(); the remaining window is a clean
+	 * failure and the frame stays in the software bridge.
+	 */
+	return -EEXIST;
 }
 
 static int airoha_ppe_foe_flow_commit_entry(struct airoha_ppe *ppe,
@@ -1158,6 +1207,404 @@ static int airoha_ppe_foe_flow_commit_entry(struct airoha_ppe *ppe,
 	return 0;
 }
 
+/* True when a frame forwarded to @egress in @vid needs no VLAN tag rewrite,
+ * i.e. when the egress bridge port emits it untagged.
+ *
+ * vid 0 is the untagged domain used by a bridge without VLAN filtering (and
+ * by a VLAN-filtering bridge that has no PVID): there is no tag to add or
+ * strip. For a real VLAN, ask the bridge for the membership flags of the
+ * egress port; @egress is a bridge port here. The RCU variant is used because
+ * this runs in the RX path and may be called with ppe_lock held.
+ *
+ * TODO(AN7581 tag handling): the PPE L2B template built by
+ * airoha_ppe_bridge_fdb_promote() always clears the egress VLAN fields, so
+ * only "untagged in, untagged out" can be expressed. Pushing a tag for a
+ * tagged @vid or popping one from a tagged ingress frame needs hardware
+ * validation (airoha_ppe_foe_entry_prepare() only records tags coming from
+ * FLOW_ACTION_VLAN_PUSH actions, and the driver treats FLOW_ACTION_VLAN_POP
+ * as a no-op). AIROHA_FOE_IB2_PCP exists in the FOE as well, but the offload
+ * path drops act->vlan.prio today, so the PCP cannot be reproduced either.
+ */
+static bool airoha_ppe_fdb_vlan_is_untagged(struct net_device *egress, u16 vid)
+{
+	struct bridge_vlan_info vinfo;
+
+	if (!vid)
+		return true;
+
+	if (br_vlan_get_info_rcu(egress, vid, &vinfo))
+		return false;
+
+	return vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED;
+}
+
+/* Drop the L2 flows promoted from @fdb and invalidate their FOE entries.
+ * Must not be called with ppe_lock held, airoha_ppe_foe_flow_remove_entry()
+ * takes it.
+ */
+static void airoha_ppe_fdb_flows_flush(struct airoha_ppe *ppe,
+				       struct airoha_fdb_entry *fdb)
+{
+	struct airoha_flow_table_entry *e, *n;
+
+	list_for_each_entry_safe(e, n, &fdb->flows, fdb_node) {
+		list_del_init(&e->fdb_node);
+		airoha_ppe_foe_flow_remove_entry(ppe, e);
+		kfree(e);
+	}
+}
+
+/* @fdb must already be removed from ppe->fdb_table. */
+static void airoha_ppe_fdb_entry_free(struct airoha_ppe *ppe,
+				      struct airoha_fdb_entry *fdb)
+{
+	airoha_ppe_fdb_flows_flush(ppe, fdb);
+	dev_put(fdb->egress);
+	kfree(fdb);
+}
+
+static void airoha_ppe_bridge_fdb_flush(struct airoha_ppe *ppe)
+{
+	struct airoha_fdb_entry *fdb, *n;
+
+	list_for_each_entry_safe(fdb, n, &ppe->fdb_list, list) {
+		list_del_init(&fdb->list);
+		rhashtable_remove_fast(&ppe->fdb_table, &fdb->node,
+				       airoha_fdb_table_params);
+		airoha_ppe_fdb_entry_free(ppe, fdb);
+	}
+}
+
+/* True while @hash still holds the unbound, hardware-learned L2B entry of
+ * the frame that triggered the RX slow path. Caller must hold ppe_lock.
+ */
+static bool airoha_ppe_foe_is_bridge_slowpath(struct airoha_ppe *ppe, u32 hash)
+{
+	struct airoha_foe_entry *hwe;
+
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!hwe)
+		return false;
+
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) ==
+	    AIROHA_FOE_STATE_BIND)
+		return false;
+
+	/* Only L2B entries are bridging candidates. */
+	return FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
+	       PPE_PKT_TYPE_BRIDGE;
+}
+
+/* Attach the NPU on demand for the bridge path.
+ *
+ * eth->npu is assigned by airoha_ppe_offload_setup(), which is only called
+ * from the nft flowtable path (TC_SETUP_FT). A box that only bridges never
+ * goes through that path, so its PPE entries would never be committed.
+ *
+ * airoha_ppe_offload_setup() cannot run in the RX softirq: it may call
+ * request_module(), sleeps in the NPU firmware handshake and polls the PPE
+ * registers. Hand the attach to a work item instead. schedule_work()
+ * coalesces the requests from every frame, and a failed attempt leaves the
+ * frames to the software bridge and is retried by the next one.
+ */
+static void airoha_ppe_bridge_fdb_schedule_npu_attach(struct airoha_ppe *ppe)
+{
+	/* Already attached, or the device is going away. */
+	if (rcu_access_pointer(ppe->eth->npu) ||
+	    test_bit(AIROHA_PPE_NPU_ATTACH_DISABLED, &ppe->npu_attach_state))
+		return;
+
+	/* One work item at a time. If it is already queued or running there is
+	 * nothing to do; the worker clears the bit when it is finished.
+	 */
+	if (test_and_set_bit(AIROHA_PPE_NPU_ATTACH_SCHEDULED,
+			     &ppe->npu_attach_state))
+		return;
+
+	if (!schedule_work(&ppe->npu_attach_work))
+		clear_bit(AIROHA_PPE_NPU_ATTACH_SCHEDULED,
+			  &ppe->npu_attach_state);
+}
+
+/* Promote the frame received on the RX slow path into a per-flow FOE entry.
+ *
+ * The bridge FDB maps the destination MAC (+VID) to the egress port, while
+ * the PPE L2B/FOE hash is keyed on the whole (source MAC, destination MAC)
+ * pair of a flow. That pair is already in the hardware-learned entry stored
+ * in @hash: airoha_ppe_foe_commit_subflow_entry() keeps the learned key and
+ * only copies the egress information of the template built here, so the
+ * missing source MAC is resolved implicitly by the RX slow path itself.
+ */
+static void airoha_ppe_bridge_fdb_promote(struct airoha_ppe *ppe,
+					  struct sk_buff *skb, u32 hash)
+{
+	struct airoha_flow_table_entry *e, *prev;
+	struct airoha_fdb_entry *fdb;
+	struct airoha_gdm_dev *egress_dev;
+	struct airoha_flow_data data = {};
+	struct airoha_foe_entry hwe;
+	struct airoha_fdb_key key;
+	struct net_device *egress;
+	struct ethhdr *eh = eth_hdr(skb);
+	bool tagged;
+	u16 vid;
+	int err;
+
+	/* airoha_ppe_foe_commit_entry() returns -ENODEV until the NPU has been
+	 * set up by the nft flowtable path, and that failure used to be ignored
+	 * after l2_flows had already been updated. Nothing can be offloaded
+	 * yet: leave the frame to the software bridge and count it.
+	 */
+	if (!rcu_access_pointer(ppe->eth->npu)) {
+		WRITE_ONCE(ppe->fdb_stats.no_npu, ppe->fdb_stats.no_npu + 1);
+		return;
+	}
+
+	/* Broadcast, multicast and unknown unicast destinations are flooded
+	 * by the software bridge: only learned destinations are offloaded.
+	 */
+	if (is_multicast_ether_addr(eh->h_dest))
+		return;
+
+	/* Work out the VID the bridge uses for this frame. An untagged frame is
+	 * classified into the PVID of its ingress bridge port (0 when the port
+	 * is not a VLAN-filtering bridge port); a tagged frame carries its own
+	 * VID, either in the packet or in the skb metadata when the tag was
+	 * offloaded. v1 only offloads the fully untagged case, see below.
+	 */
+	rcu_read_lock();
+	if (skb_vlan_tag_present(skb)) {
+		vid = skb_vlan_tag_get_id(skb);
+		tagged = true;
+	} else if (skb->protocol == htons(ETH_P_8021Q) ||
+		   skb->protocol == htons(ETH_P_8021AD)) {
+		/* The tag is still in the packet: this driver does not strip it
+		 * on RX, so the frame is tagged as well.
+		 */
+		vid = 0;
+		tagged = true;
+	} else {
+		u16 pvid;
+
+		vid = 0;
+		if (!br_vlan_get_pvid_rcu(skb->dev, &pvid))
+			vid = pvid;
+		tagged = false;
+	}
+	rcu_read_unlock();
+
+	/* A tagged ingress frame needs a tag pop and a tagged egress port needs
+	 * a tag push; neither can be expressed on the PPE L2B entry yet. Leave
+	 * the frame to the software bridge, visibly.
+	 */
+	if (tagged) {
+		WRITE_ONCE(ppe->fdb_stats.vlan_rewrite,
+			   ppe->fdb_stats.vlan_rewrite + 1);
+		return;
+	}
+
+	ether_addr_copy(key.addr, eh->h_dest);
+	key.vid = vid;
+
+	/* airoha_ppe_foe_entry_prepare() resolves the PON GEM/T-CONT mapping
+	 * under flow_offload_mutex. This runs in the RX path, so take the lock
+	 * without sleeping and leave the frame to the software bridge if it is
+	 * busy.
+	 */
+	if (!mutex_trylock(&flow_offload_mutex))
+		return;
+
+	spin_lock_bh(&ppe_lock);
+
+	fdb = rhashtable_lookup_fast(&ppe->fdb_table, &key,
+				     airoha_fdb_table_params);
+	if (!fdb || skb->dev == fdb->egress) {
+		/* Unknown destination or a frame coming from the egress port
+		 * itself: the software bridge keeps forwarding it.
+		 */
+		WRITE_ONCE(ppe->fdb_stats.no_entry,
+			   ppe->fdb_stats.no_entry + 1);
+		spin_unlock_bh(&ppe_lock);
+		goto out_unlock_mutex;
+	}
+
+	/* The key is the VID the bridge learned the destination in, so the
+	 * egress port must emit that VID untagged for the frame to need no tag
+	 * rewrite. Otherwise keep it in software, visibly.
+	 */
+	rcu_read_lock();
+	tagged = !airoha_ppe_fdb_vlan_is_untagged(fdb->egress, vid);
+	rcu_read_unlock();
+	if (tagged) {
+		WRITE_ONCE(ppe->fdb_stats.vlan_rewrite,
+			   ppe->fdb_stats.vlan_rewrite + 1);
+		spin_unlock_bh(&ppe_lock);
+		goto out_unlock_mutex;
+	}
+
+	egress = fdb->egress;
+	dev_hold(egress);
+	spin_unlock_bh(&ppe_lock);
+
+	memcpy(data.eth.h_dest, eh->h_dest, ETH_ALEN);
+	memcpy(data.eth.h_source, eh->h_source, ETH_ALEN);
+
+	err = airoha_ppe_foe_entry_prepare(ppe->eth, &hwe, egress,
+					   PPE_PKT_TYPE_BRIDGE, &data, 0, 0,
+					   &egress_dev);
+	if (err)
+		goto out_put;
+
+	e = kzalloc_obj(*e, GFP_ATOMIC);
+	if (!e)
+		goto out_put;
+
+	INIT_LIST_HEAD(&e->fdb_node);
+	e->egress_dev = egress_dev;
+	memcpy(&e->data, &hwe, sizeof(e->data));
+
+	spin_lock_bh(&ppe_lock);
+
+	/* Re-check the FDB entry and the hardware slow-path entry, both can
+	 * change while the template is built.
+	 */
+	fdb = rhashtable_lookup_fast(&ppe->fdb_table, &key,
+				     airoha_fdb_table_params);
+	if (!fdb || fdb->egress != egress ||
+	    !airoha_ppe_foe_is_bridge_slowpath(ppe, hash))
+		goto out_free;
+
+	/* A concurrent insertion of the same (source MAC, destination MAC)
+	 * tuple wins: reuse it instead of replacing it. The commit path rejects
+	 * an existing entry with -EEXIST now, so this lookup only avoids the
+	 * clean failure and the software forward on the next frame.
+	 */
+	prev = rhashtable_lookup_fast(&ppe->l2_flows, &e->data.bridge,
+				      airoha_l2_flow_table_params);
+	if (prev) {
+		err = airoha_ppe_foe_commit_subflow_entry(ppe, prev, hash,
+							  false);
+		goto out_free;
+	}
+
+	err = airoha_ppe_foe_flow_commit_entry(ppe, e);
+	if (err)
+		goto out_free;
+
+	err = airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, false);
+	if (err) {
+		/* Undo the l2_flows insertion: the destination keeps being
+		 * forwarded by the software bridge and the next frame retries.
+		 */
