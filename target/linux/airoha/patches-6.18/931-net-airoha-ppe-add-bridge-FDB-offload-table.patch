+static void airoha_ppe_npu_attach_work(struct work_struct *work)
+{
+	struct airoha_ppe *ppe = container_of(work, struct airoha_ppe,
+					      npu_attach_work);
+	struct airoha_eth *eth = ppe->eth;
+	int err = 0;
+
+	/* Serialise with the nft flowtable path, which attaches the NPU under
+	 * the same mutex, and re-check eth->npu so that only one of the two
+	 * takes the reference. This runs in process context and may sleep.
+	 */
+	mutex_lock(&flow_offload_mutex);
+
+	if (!test_bit(AIROHA_PPE_NPU_ATTACH_DISABLED, &ppe->npu_attach_state) &&
+	    !rcu_access_pointer(eth->npu))
+		err = airoha_ppe_offload_setup(eth);
+
+	mutex_unlock(&flow_offload_mutex);
+
+	clear_bit(AIROHA_PPE_NPU_ATTACH_SCHEDULED, &ppe->npu_attach_state);
+
+	if (err)
+		dev_warn_ratelimited(eth->dev,
+				     "failed to attach the NPU for bridge offload: %d\n",
+				     err);
+}
