+	 * operator, the frame was forwarded by the software bridge anyway.
+	 */
+	if (err)
+		dev_warn_ratelimited(ppe->eth->dev,
+				     "failed to promote bridge flow to %pM: %d\n",
+				     eh->h_dest, err);
+	kfree(e);
+out_put:
+	dev_put(egress);
+out_unlock_mutex:
+	mutex_unlock(&flow_offload_mutex);
+}
