From: Kitsune <km2077@foxmail.com>
Subject: [PATCH] net: airoha: ppe: add a bridge FDB offload table

The PPE can only forward bridged traffic on its own once it owns an L2B
entry for the (source MAC, destination MAC) pair of a flow, and nothing in
the driver installs such entries on behalf of the Linux bridge: the
l2_flows table is filled by the netfilter offload path only, so every other
bridged frame - PPPoE and other non-IP L2 traffic in particular - keeps
being forwarded by the software bridge.

Track the bridge forwarding database instead. An FDB entry only carries
"destination MAC (+VLAN) -> egress port" while the PPE hash is keyed on the
whole (source MAC, destination MAC) pair, so keep the FDB view in its own
table and resolve the missing source MAC from the first frame of a flow in
the RX slow path, reusing the existing l2_flows machinery to build and
commit the per-flow FOE entry.

Removing a destination drops the flows promoted from it. Frames that need a
VLAN tag rewrite, multicast/broadcast and unknown unicast destinations stay
in the software bridge: tag push/pop on the AN7581 L2B entry and multicast
replication are not implemented yet.

Signed-off-by: Kitsune <km2077@foxmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -560,6 +560,14 @@ struct airoha_flow_table_entry {
 	struct hlist_node l2_subflow_node; /* PPE L2 subflow entry */
 	u32 hash;
 
+	/* Bridge FDB entry that promoted this L2 flow, see
+	 * airoha_ppe_bridge_fdb_update(). The FDB path owns the flows it
+	 * promoted and has to invalidate their FOE entries as soon as the bridge
+	 * removes the destination, without being able to walk ppe->l2_flows
+	 * from the (possibly atomic) FDB event.
+	 */
+	struct list_head fdb_node;
+
 	struct airoha_foe_stats64 stats;
 	enum airoha_flow_entry_type type;
 
@@ -576,6 +584,39 @@ struct airoha_flow_table_entry {
 	struct airoha_foe_entry data;
 };
 
+/* Bridge FDB offload key. The software bridge only tracks the destination
+ * MAC and the VLAN, while the PPE L2B/FOE hash is keyed on the whole
+ * (source MAC, destination MAC) pair of a flow, so the source MAC is
+ * resolved from the first frame of each flow in the RX slow path, see
+ * airoha_ppe_bridge_fdb_promote().
+ */
+struct airoha_fdb_key {
+	u8 addr[ETH_ALEN];
+	u16 vid;
+};
+
+enum airoha_fdb_flags {
+	/* The software bridge would rewrite the VLAN tag on this egress port.
+	 * Tag push/pop on the native AN7581 L2B entry has not been verified
+	 * on hardware yet, so such entries stay in the software bridge.
+	 */
+	AIROHA_FDB_F_NO_OFFLOAD,
+};
+
+struct airoha_fdb_entry {
+	struct rhash_head node;
+
+	/* All bridge FDB entries, for teardown. */
+	struct list_head list;
+
+	/* L2 flows promoted from this entry (airoha_flow_table_entry). */
+	struct list_head flows;
+
+	struct airoha_fdb_key key;
+	struct net_device *egress;
+	unsigned long flags;
+};
+
 struct airoha_wdma_info {
 	u8 idx;
 	u8 queue;
@@ -717,6 +758,17 @@ struct airoha_ppe {
 
 	struct rhashtable l2_flows;
 
+	/* Bridge FDB offload table, keyed on destination MAC + VLAN. */
+	struct rhashtable fdb_table;
+	struct list_head fdb_list;
+
+	/* Bridge FDB offload counters. */
+	struct {
+		unsigned long promoted; /* L2 flows promoted from the FDB */
+		unsigned long no_entry; /* no FDB entry for the destination */
+		unsigned long tagged;   /* tagged frame, left to the bridge */
+	} fdb_stats;
+
 	struct hlist_head *foe_flow;
 	u16 *foe_check_time;
 
@@ -840,6 +892,8 @@ airoha_qdma_deref(struct airoha_gdm_dev *dev)
 void airoha_ppe_set_mtu(struct airoha_gdm_dev *dev);
 void airoha_ppe_set_cpu_port(struct airoha_gdm_dev *dev, u8 ppe_id, u8 fport);
 void airoha_ppe_remove_egress_flows(struct airoha_gdm_dev *dev);
+int airoha_ppe_bridge_fdb_update(struct airoha_eth *eth, const u8 *addr,
+				 u16 vid, struct net_device *egress, bool add);
 bool airoha_ppe_is_enabled(struct airoha_eth *eth, int index);
 void airoha_ppe_check_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 			  u16 hash, bool rx_wlan);
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -38,6 +38,13 @@ static const struct rhashtable_params airoha_l2_flow_table_params = {
 	.automatic_shrinking = true,
 };
 
+static const struct rhashtable_params airoha_fdb_table_params = {
+	.head_offset = offsetof(struct airoha_fdb_entry, node),
+	.key_offset = offsetof(struct airoha_fdb_entry, key),
+	.key_len = sizeof(struct airoha_fdb_key),
+	.automatic_shrinking = true,
+};
+
 static int airoha_ppe_get_num_stats_entries(struct airoha_ppe *ppe)
 {
 	if (!IS_ENABLED(CONFIG_NET_AIROHA_FLOW_STATS))
@@ -1059,14 +1066,24 @@ commit:
 	return 0;
 }
 
-static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
-					struct sk_buff *skb,
-					u32 hash, bool rx_wlan)
+/* Outcome of the RX slow path for one PPE hash slot. */
+enum airoha_foe_slowpath {
+	/* No L2B entry, or an entry this driver does not handle. */
+	AIROHA_FOE_SLOWPATH_NONE,
+	/* A FOE entry was committed for this hash. */
+	AIROHA_FOE_SLOWPATH_HANDLED,
+	/* Unbound native L2B entry: the bridge FDB may know the destination. */
+	AIROHA_FOE_SLOWPATH_BRIDGE,
+};
+
+static enum airoha_foe_slowpath
+airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe, struct sk_buff *skb,
+			    u32 hash, bool rx_wlan)
 {
 	struct airoha_flow_table_entry *e;
 	struct airoha_foe_bridge br = {};
 	struct airoha_foe_entry *hwe;
-	bool commit_done = false;
+	bool commit_done = false, bridge_miss = false;
 	struct hlist_node *n;
 	u32 index, state;
 
@@ -1083,8 +1100,10 @@ static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
 	/* Native L2B uses its learned key, not an IPv4/L4 software hash bucket. */
 	if (airoha_is_7581(ppe->eth) &&
 	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
-	    PPE_PKT_TYPE_BRIDGE)
+	    PPE_PKT_TYPE_BRIDGE) {
+		bridge_miss = true;
 		goto l2_lookup;
+	}
 
 	index = airoha_ppe_foe_get_entry_hash(ppe, hwe);
 	hlist_for_each_entry_safe(e, n, &ppe->foe_flow[index], list) {
@@ -1112,10 +1131,20 @@ l2_lookup:
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
 				   airoha_l2_flow_table_params);
-	if (e)
+	if (e) {
 		airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, rx_wlan);
+		commit_done = true;
+	}
 unlock:
 	spin_unlock_bh(&ppe_lock);
+
+	if (commit_done)
+		return AIROHA_FOE_SLOWPATH_HANDLED;
+
+	if (bridge_miss)
+		return AIROHA_FOE_SLOWPATH_BRIDGE;
+
+	return AIROHA_FOE_SLOWPATH_NONE;
 }
 
 static int
@@ -1158,6 +1187,295 @@ static int airoha_ppe_foe_flow_commit_entry(struct airoha_ppe *ppe,
 	return 0;
 }
 
+/* v1 only offloads destinations the software bridge would emit untagged.
+ *
+ * A non-zero VLAN means the bridge tracks a VLAN on this egress port and the
+ * frame may need a tag push or pop that the PPE template built below does not
+ * describe: airoha_ppe_foe_entry_prepare() only records tags coming from
+ * FLOW_ACTION_VLAN_PUSH actions and the driver treats FLOW_ACTION_VLAN_POP
+ * as a no-op, so the strip case cannot be expressed yet.
+ *
+ * TODO(AN7581 tag handling): ask the bridge with
+ * br_vlan_get_info_rcu(egress, vid, &vinfo) whether the port member of @vid
+ * carries BRIDGE_VLAN_INFO_UNTAGGED and offload those entries once tag push
+ * and pop have been validated on hardware. AIROHA_FOE_IB2_PCP exists in the
+ * FOE as well, but the offload path drops act->vlan.prio today, so the PCP
+ * cannot be reproduced either.
+ */
+static bool airoha_ppe_fdb_vlan_is_untagged(u16 vid)
+{
+	return !vid;
+}
+
+/* Drop the L2 flows promoted from @fdb and invalidate their FOE entries.
+ * Must not be called with ppe_lock held, airoha_ppe_foe_flow_remove_entry()
+ * takes it.
+ */
+static void airoha_ppe_fdb_flows_flush(struct airoha_ppe *ppe,
+				       struct airoha_fdb_entry *fdb)
+{
+	struct airoha_flow_table_entry *e, *n;
+
+	list_for_each_entry_safe(e, n, &fdb->flows, fdb_node) {
+		list_del_init(&e->fdb_node);
+		airoha_ppe_foe_flow_remove_entry(ppe, e);
+		kfree(e);
+	}
+}
+
+/* @fdb must already be removed from ppe->fdb_table. */
+static void airoha_ppe_fdb_entry_free(struct airoha_ppe *ppe,
+				      struct airoha_fdb_entry *fdb)
+{
+	airoha_ppe_fdb_flows_flush(ppe, fdb);
+	dev_put(fdb->egress);
+	kfree(fdb);
+}
+
+static void airoha_ppe_bridge_fdb_flush(struct airoha_ppe *ppe)
+{
+	struct airoha_fdb_entry *fdb, *n;
+
+	list_for_each_entry_safe(fdb, n, &ppe->fdb_list, list) {
+		list_del_init(&fdb->list);
+		rhashtable_remove_fast(&ppe->fdb_table, &fdb->node,
+				       airoha_fdb_table_params);
+		airoha_ppe_fdb_entry_free(ppe, fdb);
+	}
+}
+
+/* True while @hash still holds the unbound, hardware-learned L2B entry of
+ * the frame that triggered the RX slow path. Caller must hold ppe_lock.
+ */
+static bool airoha_ppe_foe_is_bridge_slowpath(struct airoha_ppe *ppe, u32 hash)
+{
+	struct airoha_foe_entry *hwe;
+
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!hwe)
+		return false;
+
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) ==
+	    AIROHA_FOE_STATE_BIND)
+		return false;
+
+	/* Only L2B entries are bridging candidates. */
+	return FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
+	       PPE_PKT_TYPE_BRIDGE;
+}
+
+/* Promote the frame received on the RX slow path into a per-flow FOE entry.
+ *
+ * The bridge FDB maps the destination MAC (+VID) to the egress port, while
+ * the PPE L2B/FOE hash is keyed on the whole (source MAC, destination MAC)
+ * pair of a flow. That pair is already in the hardware-learned entry stored
+ * in @hash: airoha_ppe_foe_commit_subflow_entry() keeps the learned key and
+ * only copies the egress information of the template built here, so the
+ * missing source MAC is resolved implicitly by the RX slow path itself.
+ */
+static void airoha_ppe_bridge_fdb_promote(struct airoha_ppe *ppe,
+					  struct sk_buff *skb, u32 hash)
+{
+	struct airoha_flow_table_entry *e, *prev;
+	struct airoha_fdb_entry *fdb;
+	struct airoha_gdm_dev *egress_dev;
+	struct airoha_flow_data data = {};
+	struct airoha_foe_entry hwe;
+	struct airoha_fdb_key key;
+	struct net_device *egress;
+	struct ethhdr *eh = eth_hdr(skb);
+	int err;
+
+	/* Broadcast, multicast and unknown unicast destinations are flooded
+	 * by the software bridge: only learned destinations are offloaded.
+	 */
+	if (is_multicast_ether_addr(eh->h_dest))
+		return;
+
+	/* v1 leaves tagged frames to the software bridge, see
+	 * airoha_ppe_fdb_vlan_is_untagged().
+	 */
+	if (skb->protocol == htons(ETH_P_8021Q) ||
+	    skb->protocol == htons(ETH_P_8021AD)) {
+		WRITE_ONCE(ppe->fdb_stats.tagged, ppe->fdb_stats.tagged + 1);
+		return;
+	}
+
+	ether_addr_copy(key.addr, eh->h_dest);
+	key.vid = 0;
+
+	/* airoha_ppe_foe_entry_prepare() resolves the PON GEM/T-CONT mapping
+	 * under flow_offload_mutex. This runs in the RX path, so take the lock
+	 * without sleeping and leave the frame to the software bridge if it is
+	 * busy.
+	 */
+	if (!mutex_trylock(&flow_offload_mutex))
+		return;
+
+	spin_lock_bh(&ppe_lock);
+
+	fdb = rhashtable_lookup_fast(&ppe->fdb_table, &key,
+				     airoha_fdb_table_params);
+	if (!fdb || (fdb->flags & AIROHA_FDB_F_NO_OFFLOAD) ||
+	    skb->dev == fdb->egress) {
+		/* Unknown destination, tag rewriting or a frame coming from the
+		 * egress port itself: the software bridge keeps forwarding it.
+		 */
+		WRITE_ONCE(ppe->fdb_stats.no_entry,
+			   ppe->fdb_stats.no_entry + 1);
+		spin_unlock_bh(&ppe_lock);
+		goto out_unlock_mutex;
+	}
+
+	egress = fdb->egress;
+	dev_hold(egress);
+	spin_unlock_bh(&ppe_lock);
+
+	memcpy(data.eth.h_dest, eh->h_dest, ETH_ALEN);
+	memcpy(data.eth.h_source, eh->h_source, ETH_ALEN);
+
+	err = airoha_ppe_foe_entry_prepare(ppe->eth, &hwe, egress,
+					   PPE_PKT_TYPE_BRIDGE, &data, 0, 0,
+					   &egress_dev);
+	if (err)
+		goto out_put;
+
+	e = kzalloc_obj(*e, GFP_ATOMIC);
+	if (!e)
+		goto out_put;
+
+	INIT_LIST_HEAD(&e->fdb_node);
+	e->egress_dev = egress_dev;
+	memcpy(&e->data, &hwe, sizeof(e->data));
+
+	spin_lock_bh(&ppe_lock);
+
+	/* Re-check the FDB entry and the hardware slow-path entry, both can
+	 * change while the template is built.
+	 */
+	fdb = rhashtable_lookup_fast(&ppe->fdb_table, &key,
+				     airoha_fdb_table_params);
+	if (!fdb || fdb->egress != egress ||
+	    !airoha_ppe_foe_is_bridge_slowpath(ppe, hash))
+		goto out_free;
+
+	/* A concurrent insertion of the same (source MAC, destination MAC)
+	 * pair wins: reuse it instead of replacing it, since
+	 * airoha_ppe_foe_l2_flow_commit_entry() would only drop the entry
+	 * installed by the netfilter offload path.
+	 */
+	prev = rhashtable_lookup_fast(&ppe->l2_flows, &e->data.bridge,
+				      airoha_l2_flow_table_params);
+	if (prev) {
+		airoha_ppe_foe_commit_subflow_entry(ppe, prev, hash, false);
+		goto out_free;
+	}
+
+	err = airoha_ppe_foe_flow_commit_entry(ppe, e);
+	if (err)
+		goto out_free;
+
+	airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, false);
+	list_add_tail(&e->fdb_node, &fdb->flows);
+	e = NULL;
+	WRITE_ONCE(ppe->fdb_stats.promoted, ppe->fdb_stats.promoted + 1);
+
+out_free:
+	spin_unlock_bh(&ppe_lock);
+	kfree(e);
+out_put:
+	dev_put(egress);
+out_unlock_mutex:
+	mutex_unlock(&flow_offload_mutex);
+}
+
+/**
+ * airoha_ppe_bridge_fdb_update() - track a bridge FDB entry for PPE offload
+ * @eth: airoha ethernet device
+ * @addr: MAC address the bridge learned, destination of the offloaded flows
+ * @vid: bridge VLAN the address was learned in
+ * @egress: net_device the address was learned on, the egress port to use
+ * @add: true to add, false to delete the entry
+ *
+ * Keep the bridge forwarding database in sync so that the RX slow path can
+ * resolve the destination of a frame to an egress port and promote the flow
+ * into a PPE_PKT_TYPE_BRIDGE entry. Deleting an entry also drops the flows
+ * promoted from it, otherwise the PPE would keep forwarding them to the old
+ * port until the L2B entry ages out.
+ *
+ * Return: 0 on success, a negative error code otherwise. A failure only
+ * means that the destination keeps being forwarded by the software bridge.
+ */
+int airoha_ppe_bridge_fdb_update(struct airoha_eth *eth, const u8 *addr,
+				 u16 vid, struct net_device *egress, bool add)
+{
+	struct airoha_ppe *ppe = eth->ppe;
+	struct airoha_fdb_entry *fdb;
+	struct airoha_fdb_key key;
+	int err;
+
+	if (!ppe || !addr || !is_valid_ether_addr(addr))
+		return -EINVAL;
+
+	/* Broadcast and multicast destinations are flooded, and multicast
+	 * replication is not offloaded by this version.
+	 */
+	if (is_multicast_ether_addr(addr))
+		return -EOPNOTSUPP;
+
+	ether_addr_copy(key.addr, addr);
+	key.vid = vid;
+
+	if (!add) {
+		spin_lock_bh(&ppe_lock);
+
+		fdb = rhashtable_lookup_fast(&ppe->fdb_table, &key,
+					     airoha_fdb_table_params);
+		if (!fdb) {
+			spin_unlock_bh(&ppe_lock);
+			return -ENOENT;
+		}
+
+		rhashtable_remove_fast(&ppe->fdb_table, &fdb->node,
+				       airoha_fdb_table_params);
+		list_del_init(&fdb->list);
+		spin_unlock_bh(&ppe_lock);
+
+		airoha_ppe_fdb_entry_free(ppe, fdb);
+
+		return 0;
+	}
+
+	if (!egress || !airoha_is_valid_gdm_dev(eth, netdev_priv(egress)))
+		return -EINVAL;
+
+	fdb = kzalloc_obj(*fdb, GFP_ATOMIC);
+	if (!fdb)
+		return -ENOMEM;
+
+	INIT_LIST_HEAD(&fdb->flows);
+	fdb->key = key;
+	fdb->egress = egress;
+	if (!airoha_ppe_fdb_vlan_is_untagged(vid))
+		fdb->flags |= AIROHA_FDB_F_NO_OFFLOAD;
+
+	spin_lock_bh(&ppe_lock);
+
+	err = rhashtable_lookup_insert_fast(&ppe->fdb_table, &fdb->node,
+					    airoha_fdb_table_params);
+	if (!err) {
+		dev_hold(egress);
+		list_add_tail(&fdb->list, &ppe->fdb_list);
+	}
+
+	spin_unlock_bh(&ppe_lock);
+
+	if (err)
+		kfree(fdb);
+
+	return err;
+}
+
 static int airoha_ppe_get_entry_idle_time(struct airoha_ppe *ppe, u32 ib1)
 {
 	u32 state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1);
@@ -1705,7 +2023,10 @@ void airoha_ppe_check_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 		return;
 
 	ppe->foe_check_time[hash] = now;
-	airoha_ppe_foe_insert_entry(ppe, skb, hash, rx_wlan);
+	if (!rx_wlan &&
+	    airoha_ppe_foe_insert_entry(ppe, skb, hash, rx_wlan) ==
+	    AIROHA_FOE_SLOWPATH_BRIDGE)
+		airoha_ppe_bridge_fdb_promote(ppe, skb, hash);
 }
 
 void airoha_ppe_init_upd_mem(struct airoha_gdm_dev *dev, const u8 *addr)
@@ -1840,12 +2161,19 @@ int airoha_ppe_init(struct airoha_eth *eth)
 	if (err)
 		goto error_flow_table_destroy;
 
-	err = airoha_ppe_debugfs_init(ppe);
+	INIT_LIST_HEAD(&ppe->fdb_list);
+	err = rhashtable_init(&ppe->fdb_table, &airoha_fdb_table_params);
 	if (err)
 		goto error_l2_flow_table_destroy;
 
+	err = airoha_ppe_debugfs_init(ppe);
+	if (err)
+		goto error_fdb_table_destroy;
+
 	return 0;
 
+error_fdb_table_destroy:
+	rhashtable_destroy(&ppe->fdb_table);
 error_l2_flow_table_destroy:
 	rhashtable_destroy(&ppe->l2_flows);
 error_flow_table_destroy:
@@ -1870,6 +2198,8 @@ void airoha_ppe_deinit(struct airoha_eth *eth)
 
 	mutex_unlock(&flow_offload_mutex);
 
+	airoha_ppe_bridge_fdb_flush(eth->ppe);
+
 	rhashtable_destroy(&eth->ppe->l2_flows);
 	rhashtable_destroy(&eth->flow_table);
 	debugfs_remove(eth->ppe->debugfs_dir);
