 		airoha_ppe_fdb_stat_inc(&ppe->fdb_stats.rx_no_slot);
-		airoha_ppe_l2b_dbg_record(ppe, skb, hash, reason, 0, 0,
-					  AIROHA_FOE_STATE_INVALID, 0,
