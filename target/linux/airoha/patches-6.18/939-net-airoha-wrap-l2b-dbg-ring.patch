From: Kitsune <km2077@foxmail.com>
Subject: [PATCH] net: airoha: wrap the L2B diagnostic ring and dump the slot

938 made the slow-path gate accept a native L2B entry, but the HG5382A
still rejects every bridged test frame: after 300 frames fdb_rx_no_slot
rose by the same +456 as fdb_rx_no_flow, fdb_promoted stayed 0 and no
BRIDGE entry appeared. The 937 ring cannot explain that because it keeps
the first 32 refused frames after boot, and those were all ambient traffic
(type=4/5 IPv4/L4 entries); the test frames arrive later and are never
recorded.

Turn the 32-entry ring into a wrapping ring: once full, the next record
overwrites the oldest slot, so l2b_dbg always shows the last 32 refused
frames. recorded still reports how many slots are valid, a new total
counter keeps the lifetime number of records and every record carries its
sequence number.

Extend each record with a raw dump of the candidate FOE entry: 16 u32
words, offsets 0..63. The copy is taken under the existing ppe_lock through
airoha_ppe_foe_get_entry_locked(), is read-only and is made before the lock
is dropped, so debugfs never dereferences the DMA entry. This shows where
the native destination/source MACs actually live if 930's layout
assumption is wrong.

Add per-reject counters next to the fdb_* totals: RANGE, NO_ENTRY, BIND,
TYPE, KEY (the native layout was present but its MACs did not match this
frame) and ACCEPTED (the gate passed and the commit was attempted). Print
the two MACs the gate compares against the frame (entry_dst, entry_src)
and the frame's own skb_dst, skb_src in the l2b_dbg row, so a key mismatch
is visible without decoding the dump.

Nothing else changes: no PPE or FOE write, no new commit path, no change
to the forwarding decision or to the 938 layout check. Rejected frames
still increment fdb_rx_no_slot and stay with the software bridge.

This is 939-net-airoha-wrap-l2b-dbg-ring.patch.

Signed-off-by: Kitsune <km2077@foxmail.com>
---
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index a30c982b8..f06ead82c 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -785,34 +785,53 @@ enum airoha_ppe_cpu_reason {
 	AIROHA_PPE_CPU_REASON_HIT_PRE_BIND		= 0x1a,
 };
 
-/* Maximum number of rejected bridge RX frames kept for /sys/kernel/debug/ppe/l2b_dbg.
- * The RX path stops recording once the array is full; the running total stays
- * available in fdb_stats.rx_no_flow/rx_no_slot.
+/* Number of rejected bridge RX frames kept for /sys/kernel/debug/ppe/l2b_dbg.
+ * The ring wraps: once every slot has been written the oldest record is
+ * overwritten, so the file always shows the last AIROHA_PPE_L2B_DBG_MAX
+ * rejected frames. l2b_dbg.total keeps the lifetime count. The RX path still
+ * performs no allocation.
  */
 #define AIROHA_PPE_L2B_DBG_MAX		32
 
+/* Number of u32 words of the candidate FOE entry captured per record: entry
+ * bytes 0..63. A whole PPE entry is 80 bytes; the first 64 cover ib1, the
+ * native ingress key and the native l2b.data/ib2 words.
+ */
+#define AIROHA_PPE_L2B_DBG_WORDS	16
+
 /* Why the bridge RX slow path did not hand a descriptor slot to the promote
  * path. Diagnostic only; nothing here changes forwarding.
  */
 enum airoha_ppe_l2b_reject {
-	AIROHA_L2B_REJECT_RANGE = 1,	/* index outside the PPE table */
+	AIROHA_L2B_REJECT_RANGE = 0,	/* index outside the PPE table */
 	AIROHA_L2B_REJECT_NO_ENTRY,	/* index has no readable FOE entry */
 	AIROHA_L2B_REJECT_BIND,		/* slot is already bound */
-	AIROHA_L2B_REJECT_TYPE,		/* slot is not PPE_PKT_TYPE_BRIDGE */
+	AIROHA_L2B_REJECT_TYPE,		/* slot is neither layout */
+	AIROHA_L2B_REJECT_KEY,		/* native layout, MACs do not match */
+	AIROHA_L2B_REJECT_MAX,
 };
 
 /* One rejected frame, captured verbatim from the descriptor and the FOE slot.
  * Filled on the RX softirq from a static array, so it must not sleep.
  */
 struct airoha_ppe_l2b_dbg {
+	u64 seq;		/* l2b_dbg.total when this record was written */
 	u32 hash;		/* AIROHA_RXD4_FOE_ENTRY as reported */
 	u32 reason;		/* AIROHA_RXD4_PPE_CPU_REASON as reported */
 	u32 ib1;		/* raw slot word 0, 0 when no slot */
 	u32 ib2;		/* raw native L2B word at entry offset 44 */
 	u32 state;		/* FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1) */
-	u32 type;		/* FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, ib1) */
+	u32 type;		/* FIELD_GET(AIROHA_FOE_IB1_PKT_TYPE, ib1) */
 	u32 reject;		/* enum airoha_ppe_l2b_reject */
 	u32 ifindex;		/* ingress netdev, 0 when skb->dev is NULL */
+	/* Candidate entry bytes 0..63, captured under ppe_lock. */
+	u32 raw[AIROHA_PPE_L2B_DBG_WORDS];
+	/* The two MACs the native gate compares, read from the l2b layout. */
+	u8 entry_dst[ETH_ALEN];
+	u8 entry_src[ETH_ALEN];
+	/* The frame the gate compared them against. */
+	u8 skb_dst[ETH_ALEN];
+	u8 skb_src[ETH_ALEN];
 	unsigned long jiffies;	/* when the frame was seen */
 };
 
@@ -859,14 +878,21 @@ struct airoha_ppe {
 		unsigned long rx_no_slot;   /* no unbound L2B slot, promote skipped */
 	} fdb_stats;
 
-	/* Diagnostic-only evidence for the bridge RX slow path. The ring is
-	 * filled with the first AIROHA_PPE_L2B_DBG_MAX rejected frames and is
+	/* Diagnostic-only evidence for the bridge RX slow path. The ring wraps:
+	 * it always holds the last AIROHA_PPE_L2B_DBG_MAX refused frames and is
 	 * read through /sys/kernel/debug/ppe/l2b_dbg. No hardware writes and no
 	 * allocation in the RX path.
 	 */
 	struct {
 		struct airoha_ppe_l2b_dbg entry[AIROHA_PPE_L2B_DBG_MAX];
-		u32 count;
+		u32 recorded;	/* valid records, at most L2B_DBG_MAX */
+		u32 head;	/* next slot to overwrite */
+		u64 total;	/* lifetime records, including wrapped ones */
+		/* Every gate rejection, by enum airoha_ppe_l2b_reject, plus
+		 * every accepted candidate that reached the commit attempt.
+		 */
+		atomic64_t reject_count[AIROHA_L2B_REJECT_MAX];
+		atomic64_t accepted;
 		spinlock_t lock;
 	} l2b_dbg;
 
