+/* Snapshot of the candidate FOE entry taken under ppe_lock. The record in the
+ * debug ring is filled from this copy after the lock is dropped, so the RX path
+ * never dereferences the DMA entry outside the critical section.
+ */
+struct airoha_ppe_l2b_slot {
+	u32 ib1;
+	u32 ib2;
+	u32 state;
+	u32 type;
+	u32 raw[AIROHA_PPE_L2B_DBG_WORDS];
+	u8 dest[ETH_ALEN];
+	u8 src[ETH_ALEN];
+};
+
+/* Copy the candidate FOE entry, including the raw words at offsets 0..63, while
+ * ppe_lock is held. Read-only: no write reaches the PPE or the DMA table.
+ * The entry is cast to u32 because the union in struct airoha_foe_entry is
+ * naturally aligned and the raw dump must start at ib1 (offset 0).
+ *
+ * Caller must hold ppe_lock.
+ */
+static void airoha_ppe_l2b_dbg_capture_slot(struct airoha_foe_entry *hwe,
+					    struct airoha_ppe_l2b_slot *slot)
+{
+	const u32 *words = (const u32 *)hwe;
+	unsigned int i;
+
+	lockdep_assert_held(&ppe_lock);
+
+	slot->ib1 = READ_ONCE(hwe->ib1);
+	slot->ib2 = READ_ONCE(hwe->l2b.ib2);
+	slot->state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, slot->ib1);
+	slot->type = FIELD_GET(AIROHA_FOE_IB1_PKT_TYPE, slot->ib1);
+
+	for (i = 0; i < AIROHA_PPE_L2B_DBG_WORDS; i++)
+		slot->raw[i] = READ_ONCE(words[i]);
+
+	/* Same fields airoha_ppe_foe_is_native_l2b() compares. */
+	put_unaligned_be32(READ_ONCE(hwe->l2b.dest_mac_hi), slot->dest);
+	put_unaligned_be16(READ_ONCE(hwe->l2b.dest_mac_lo), slot->dest + 4);
+	put_unaligned_be32(READ_ONCE(hwe->l2b.src_mac_hi), slot->src);
+	put_unaligned_be16(READ_ONCE(hwe->l2b.src_mac_lo), slot->src + 4);
+}
+
 /* Record one refused bridge RX frame. Diagnostic only: the slot is not
- * touched, the frame keeps going to the software bridge and the ring is left
- * alone once it is full.
+ * touched and the frame keeps going to the software bridge. The ring wraps, so
+ * the newest AIROHA_PPE_L2B_DBG_MAX records survive instead of the first ones
+ * seen after boot (which on the board were all ambient traffic). @slot is NULL
+ * when the descriptor index had no readable entry.
  */
 static void airoha_ppe_l2b_dbg_record(struct airoha_ppe *ppe,
 				      const struct sk_buff *skb,
-				      u32 hash, u32 reason, u32 ib1, u32 ib2,
-				      u32 state, u32 type,
+				      u32 hash, u32 reason,
+				      const struct airoha_ppe_l2b_slot *slot,
 				      enum airoha_ppe_l2b_reject reject)
 {
 	struct airoha_ppe_l2b_dbg *e;
 	unsigned long flags;
+	u32 head;
 
 	spin_lock_irqsave(&ppe->l2b_dbg.lock, flags);
 
-	if (ppe->l2b_dbg.count < ARRAY_SIZE(ppe->l2b_dbg.entry)) {
-		e = &ppe->l2b_dbg.entry[ppe->l2b_dbg.count++];
-		e->hash = hash;
-		e->reason = reason;
-		e->ib1 = ib1;
-		e->ib2 = ib2;
-		e->state = state;
-		e->type = type;
-		e->reject = reject;
-		e->ifindex = skb->dev ? skb->dev->ifindex : 0;
-		e->jiffies = jiffies;
+	head = ppe->l2b_dbg.head;
+	e = &ppe->l2b_dbg.entry[head];
+	ppe->l2b_dbg.head = (head + 1) % ARRAY_SIZE(ppe->l2b_dbg.entry);
+	if (ppe->l2b_dbg.recorded < ARRAY_SIZE(ppe->l2b_dbg.entry))
+		ppe->l2b_dbg.recorded++;
+	e->seq = ++ppe->l2b_dbg.total;
+
+	e->hash = hash;
+	e->reason = reason;
+	e->reject = reject;
+	e->ifindex = skb->dev ? skb->dev->ifindex : 0;
+	ether_addr_copy(e->skb_dst, eth_hdr(skb)->h_dest);
+	ether_addr_copy(e->skb_src, eth_hdr(skb)->h_source);
+	e->jiffies = jiffies;
+
+	if (slot) {
+		e->ib1 = slot->ib1;
+		e->ib2 = slot->ib2;
+		e->state = slot->state;
+		e->type = slot->type;
+		memcpy(e->raw, slot->raw, sizeof(e->raw));
+		ether_addr_copy(e->entry_dst, slot->dest);
+		ether_addr_copy(e->entry_src, slot->src);
+	} else {
+		e->ib1 = 0;
+		e->ib2 = 0;
+		e->state = AIROHA_FOE_STATE_INVALID;
+		e->type = 0;
+		memset(e->raw, 0, sizeof(e->raw));
+		eth_zero_addr(e->entry_dst);
+		eth_zero_addr(e->entry_src);
 	}
 
+	if ((unsigned int)reject < ARRAY_SIZE(ppe->l2b_dbg.reject_count))
+		atomic64_inc(&ppe->l2b_dbg.reject_count[reject]);
+
 	spin_unlock_irqrestore(&ppe->l2b_dbg.lock, flags);
 }
 
