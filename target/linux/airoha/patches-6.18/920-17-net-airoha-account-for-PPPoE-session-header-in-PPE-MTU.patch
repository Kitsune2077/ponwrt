From: naoki66 <naoki66@qq.com>
Subject: [PATCH] net: airoha: account for the PPPoE session header in PPE/WAN
 egress MTU

The WAN egress MTU register and the PPE egress MTU register are compared
against the on-wire L2 frame length without the FCS (hardware reset value
0x05EA = 1514 = ETH_HLEN + 1500), so every L2 encapsulation sitting between
the Ethernet header and the IP payload has to be added to the programmed
length. The driver currently accounts for VLAN_ETH_HLEN only.

A PPPoE session frame carries PPPOE_SES_HLEN (8) extra bytes: 6 bytes of
PPPoE header plus the 2-byte PPP protocol field. On the uplink GDM a PPPoE
session egresses through, an MTU of 1492 therefore produces frames of up to
1492 + 8 + VLAN_ETH_HLEN bytes once the operator VLAN tag is present. With
only VLAN_ETH_HLEN added, the register is programmed to 1510 while the
longest valid frame is 1518, so the hardware drops full-size PPPoE session
frames: small pings pass, large ones vanish. The same applies to a bridged
pon0 that carries a downstream PPPoE session with an operator tag.

Add the PPPoE session header on uplink GDM devices only. In
airoha_ppe_set_mtu() the MTU is aggregated across every device sharing the
QDMA/port, so the check happens per device inside the aggregation loop: a
PPPoE-capable uplink contributes mtu + VLAN_ETH_HLEN + PPPOE_SES_HLEN,
while a LAN port keeps the VLAN-only accounting and is not given eight
bytes of needless headroom.

Adapted for the PonWrt tree, which names the frame-size setter
airoha_dev_set_mtu() and keeps the aggregation inside airoha_ppe_set_mtu().

Signed-off-by: naoki66 <naoki66@qq.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2348,14 +2348,26 @@
 
 static void airoha_dev_set_mtu(struct net_device *netdev)
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	u32 len = netdev->mtu;
 
 	airoha_ppe_set_mtu(dev);
-	if (!airoha_is_lan_gdm_dev(dev))
+	/* A PPPoE session can only egress through an uplink GDM; its 8-byte
+	 * session header (6-byte pppoe_hdr + 2-byte PPP protocol) sits between
+	 * the Ethernet header and the IP payload, so it counts into the L2
+	 * frame length the WAN MTU register is compared against, on top of
+	 * the operator VLAN tag VLAN_ETH_HLEN already covers. LAN ports stay
+	 * VLAN-only.
+	 */
+	if (!airoha_is_lan_gdm_dev(dev)) {
+		if (test_bit(AIROHA_DEV_F_PON, &dev->flags))
+			len += 8; /* PPPOE_SES_HLEN */
+
 		airoha_fe_rmw(dev->eth, REG_WAN_MTU0,
 			      WAN_MTU0_MASK,
-			      FIELD_PREP(WAN_MTU0_MASK, netdev->mtu + VLAN_ETH_HLEN));
+			      FIELD_PREP(WAN_MTU0_MASK, len + VLAN_ETH_HLEN));
+	}
 }
 
 static int airoha_dev_open(struct net_device *netdev)
 {
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -171,8 +171,9 @@
 	for (i = 0; i < ARRAY_SIZE(port->devs); i++) {
 		struct airoha_gdm_dev *d = port->devs[i];
 		struct net_device *netdev;
 		struct airoha_qdma *q;
+		u32 mtu;
 
 		if (!d)
 			continue;
 
@@ -180,13 +181,23 @@
 		if (q != qdma)
 			continue;
 
 		netdev = netdev_from_priv(d);
-		if (netif_running(netdev))
-			len = max_t(u32, len, netdev->mtu);
-	}
-
-	len += VLAN_ETH_HLEN;
+		if (!netif_running(netdev))
+			continue;
+
+		/* The register is compared against the on-wire L2 length, so every
+		 * encapsulation on this egress path has to be added to the aggregated
+		 * MTU. VLAN_ETH_HLEN applies to all ports; an uplink GDM (PON) can
+		 * additionally carry a PPPoE session whose 8-byte header sits between
+		 * the Ethernet header and the IP payload.
+		 */
+		mtu = netdev->mtu + VLAN_ETH_HLEN;
+		if (test_bit(AIROHA_DEV_F_PON, &d->flags))
+			mtu += 8; /* PPPOE_SES_HLEN */
+
+		len = max_t(u32, len, mtu);
+	}
 	ppe_id = !airoha_is_lan_gdm_dev(dev) && airoha_ppe_is_enabled(eth, 1);
 	index = port->id == AIROHA_GDM4_IDX ? 7 : port->id;
 	airoha_fe_rmw(eth, REG_PPE_MTU(ppe_id, index),
 		      FP_EGRESS_MTU_MASK(index),
