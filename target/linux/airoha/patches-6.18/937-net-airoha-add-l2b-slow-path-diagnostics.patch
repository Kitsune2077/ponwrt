+		seq_printf(m, "ppe%u_bind_rate: %08x l2b_bind=%u bind=%u\n", i,
+			   airoha_fe_rr(eth, REG_PPE_BIND_RATE(i)),
+			   (u32)FIELD_GET(PPE_BIND_RATE_L2B_BIND_MASK,
