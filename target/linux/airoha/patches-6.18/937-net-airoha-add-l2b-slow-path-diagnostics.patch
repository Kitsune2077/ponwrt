--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -8,6 +8,7 @@
 #define AIROHA_ETH_H
 
 #include <linux/airoha-eth.h>
+#include <linux/atomic.h>
 #include <linux/debugfs.h>
 #include <linux/etherdevice.h>
 #include <linux/iopoll.h>
@@ -775,6 +776,37 @@
 	AIROHA_PPE_CPU_REASON_HIT_PRE_BIND		= 0x1a,
 };
 
+/* Maximum number of rejected bridge RX frames kept for /sys/kernel/debug/ppe/l2b_dbg.
+ * The RX path stops recording once the array is full; the running total stays
+ * available in fdb_stats.rx_no_flow/rx_no_slot.
+ */
+#define AIROHA_PPE_L2B_DBG_MAX		32
+
+/* Why the bridge RX slow path did not hand a descriptor slot to the promote
+ * path. Diagnostic only; nothing here changes forwarding.
+ */
+enum airoha_ppe_l2b_reject {
+	AIROHA_L2B_REJECT_RANGE = 1,	/* index outside the PPE table */
+	AIROHA_L2B_REJECT_NO_ENTRY,	/* index has no readable FOE entry */
+	AIROHA_L2B_REJECT_BIND,		/* slot is already bound */
+	AIROHA_L2B_REJECT_TYPE,		/* slot is not PPE_PKT_TYPE_BRIDGE */
+};
+
+/* One rejected frame, captured verbatim from the descriptor and the FOE slot.
+ * Filled on the RX softirq from a static array, so it must not sleep.
+ */
+struct airoha_ppe_l2b_dbg {
+	u32 hash;		/* AIROHA_RXD4_FOE_ENTRY as reported */
+	u32 reason;		/* AIROHA_RXD4_PPE_CPU_REASON as reported */
+	u32 ib1;		/* raw slot word 0, 0 when no slot */
+	u32 ib2;		/* raw native L2B word at entry offset 44 */
+	u32 state;		/* FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1) */
+	u32 type;		/* FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, ib1) */
+	u32 reject;		/* enum airoha_ppe_l2b_reject */
+	u32 ifindex;		/* ingress netdev, 0 when skb->dev is NULL */
+	unsigned long jiffies;	/* when the frame was seen */
+};
+
 /* Port parent id ("switch id") reported for every GMAC netdev of one
  * controller, see airoha_get_port_parent_id(). The bridge only compares it
  * byte for byte to decide whether two ports belong to the same hardware
@@ -818,6 +850,28 @@
 		unsigned long rx_no_slot;   /* no unbound L2B slot, promote skipped */
 	} fdb_stats;
 
+	/* Diagnostic-only evidence for the bridge RX slow path. The ring is
+	 * filled with the first AIROHA_PPE_L2B_DBG_MAX rejected frames and is
+	 * read through /sys/kernel/debug/ppe/l2b_dbg. No hardware writes and no
+	 * allocation in the RX path.
+	 */
+	struct {
+		struct airoha_ppe_l2b_dbg entry[AIROHA_PPE_L2B_DBG_MAX];
+		u32 count;
+		spinlock_t lock;
+	} l2b_dbg;
+
+	/* Raw AIROHA_RXD4_PPE_CPU_REASON histogram, 5 bits wide. Incremented
+	 * for every GDM RX descriptor before the reason is dispatched, so a
+	 * wrong CPU-reason assumption shows up here as well.
+	 */
+	atomic64_t rx_reason_count[32];
+
+	/* AIROHA_PPE_L2B_DBG_LOGGED once airoha_ppe_offload_setup() has printed
+	 * the PPE configuration.
+	 */
+	unsigned long l2b_dbg_state;
+
 	/* Inspects the bridge FDB entries offloaded to the PPE, see
 	 * airoha_ppe_fdb_refresh_work(). Only started when the
 	 * fdb_refresh_period module parameter is not 0.
@@ -962,7 +1016,7 @@
 void airoha_ppe_check_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 			  u16 hash, bool rx_wlan);
 void airoha_ppe_bridge_rx_slowpath(struct airoha_eth *eth,
-				   struct sk_buff *skb, u32 hash);
+				   struct sk_buff *skb, u32 hash, u32 reason);
 int airoha_ppe_setup_tc_block_cb(struct airoha_ppe_dev *dev, void *type_data);
 int airoha_ppe_init(struct airoha_eth *eth);
 void airoha_ppe_deinit(struct airoha_eth *eth);
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -28,6 +28,9 @@
 #define AIROHA_PPE_NPU_ATTACH_SCHEDULED	0
 #define AIROHA_PPE_NPU_ATTACH_DISABLED	1
 
+/* airoha_ppe::l2b_dbg_state bits. */
+#define AIROHA_PPE_L2B_DBG_LOGGED	0
+
 static DEFINE_SPINLOCK(ppe_lock);
 
 static const struct rhashtable_params airoha_flow_table_params = {
@@ -1718,11 +1721,85 @@
 	mutex_unlock(&flow_offload_mutex);
 }
 
+/* Record one refused bridge RX frame. Diagnostic only: the slot is not
+ * touched, the frame keeps going to the software bridge and the ring is left
+ * alone once it is full.
+ */
+static void airoha_ppe_l2b_dbg_record(struct airoha_ppe *ppe,
+				      const struct sk_buff *skb,
+				      u32 hash, u32 reason, u32 ib1, u32 ib2,
+				      u32 state, u32 type,
+				      enum airoha_ppe_l2b_reject reject)
+{
+	struct airoha_ppe_l2b_dbg *e;
+	unsigned long flags;
+
+	spin_lock_irqsave(&ppe->l2b_dbg.lock, flags);
+
+	if (ppe->l2b_dbg.count < ARRAY_SIZE(ppe->l2b_dbg.entry)) {
+		e = &ppe->l2b_dbg.entry[ppe->l2b_dbg.count++];
+		e->hash = hash;
+		e->reason = reason;
+		e->ib1 = ib1;
+		e->ib2 = ib2;
+		e->state = state;
+		e->type = type;
+		e->reject = reject;
+		e->ifindex = skb->dev ? skb->dev->ifindex : 0;
+		e->jiffies = jiffies;
+	}
+
+	spin_unlock_irqrestore(&ppe->l2b_dbg.lock, flags);
+}
+
+/* Print the PPE configuration once, right after the NPU attach programmed it.
+ * Read-only: this is the evidence needed to decide why the hardware does not
+ * leave the unbound L2B slot that the RX slow path expects.
+ *
+ * airoha_ppe_hw_init() programs PPE_TB_HASH_CFG, PPE_TB_CFG and
+ * PPE_BIND_RATE, but it never writes REG_PPE_UNBIND_AGE (0x238). The
+ * MediaTek PPE this block derives from sets MIN_PACKETS/DELTA there, so the
+ * read below tells whether the AN7581 bootloader or firmware left a value
+ * that ages the unbound entry out before the CPU sees it. This function does
+ * not write the register.
+ */
+static void airoha_ppe_l2b_dbg_log_config(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int i;
+
+	if (test_and_set_bit(AIROHA_PPE_L2B_DBG_LOGGED, &ppe->l2b_dbg_state))
+		return;
+
+	dev_info(eth->dev, "PPE diagnostic: npu_attached=%u num_ppe=%u\n",
+		 !!rcu_access_pointer(eth->npu), eth->soc->num_ppe);
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		u32 unbind_age = airoha_fe_rr(eth, REG_PPE_UNBIND_AGE(i));
+		u32 bind_rate = airoha_fe_rr(eth, REG_PPE_BIND_RATE(i));
+		u32 tb_cfg = airoha_fe_rr(eth, REG_PPE_TB_CFG(i));
+		u32 hash_cfg = airoha_fe_rr(eth, REG_PPE_TB_HASH_CFG(i));
+		u32 hash_seed = airoha_fe_rr(eth, REG_PPE_HASH_SEED(i));
+
+		dev_info(eth->dev,
+			 "PPE%u: unbind_age=%08x min_packets=%u delta=%u driver_writes_unbind_age=0 bind_rate=%08x l2b_bind=%u bind=%u tb_cfg=%08x search_miss=%u hash_cfg=%08x hash_seed=%08x\n",
+			 i, unbind_age,
+			 (u32)FIELD_GET(PPE_UNBIND_AGE_MIN_PACKETS_MASK, unbind_age),
+			 (u32)FIELD_GET(PPE_UNBIND_AGE_DELTA_MASK, unbind_age),
+			 bind_rate,
+			 (u32)FIELD_GET(PPE_BIND_RATE_L2B_BIND_MASK, bind_rate),
+			 (u32)FIELD_GET(PPE_BIND_RATE_BIND_MASK, bind_rate),
+			 tb_cfg, (u32)FIELD_GET(PPE_TB_CFG_SEARCH_MISS_MASK, tb_cfg),
+			 hash_cfg, hash_seed);
+	}
+}
+
 /**
  * airoha_ppe_bridge_rx_slowpath() - promote a bridged frame the PPE punted
  * @eth: airoha ethernet device
  * @skb: frame handed to the CPU by the PPE
  * @hash: PPE entry index from AIROHA_RXD4_FOE_ENTRY
+ * @reason: AIROHA_RXD4_PPE_CPU_REASON of this frame
  *
  * Called from the RX softirq for the CPU reasons that mean "this frame has
  * no bound flow". The descriptor entry index is only usable when the PPE left
@@ -1733,6 +1810,11 @@
  * frame inside NAPI, so a slot that does not hold an unbound BRIDGE entry is
  * counted and left to the software bridge instead of inventing a hash.
  *
+ * The diagnostic ring records the first rejected frames so a board test can
+ * see whether the descriptor index is 0xffff ("hardware built nothing"), a
+ * valid unbound BRIDGE entry (the gate accepted it), or some other slot. It
+ * performs no hardware writes and does not change forwarding.
+ *
  * The first frame can also race the asynchronous NPU attach. The attach runs
  * airoha_ppe_hw_init(), which is what enables the PPE tables, the L2B bind
  * rate and the hash seed in the first place; a pure bridge otherwise never
@@ -1741,11 +1823,12 @@
  * and let the next frame retry.
  */
 void airoha_ppe_bridge_rx_slowpath(struct airoha_eth *eth,
-				   struct sk_buff *skb, u32 hash)
+				   struct sk_buff *skb, u32 hash, u32 reason)
 {
+	struct airoha_foe_entry *hwe = NULL;
 	struct airoha_ppe *ppe = eth->ppe;
-	u32 ppe_hash_mask;
-	bool bridge_slowpath;
+	u32 ppe_hash_mask, ib1 = 0, ib2 = 0;
+	u32 state = AIROHA_FOE_STATE_INVALID, type = 0;
 
 	if (!ppe)
 		return;
@@ -1776,15 +1859,44 @@
 	ppe_hash_mask = airoha_ppe_get_total_num_entries(ppe) - 1;
 	if (hash > ppe_hash_mask) {
 		airoha_ppe_fdb_stat_inc(&ppe->fdb_stats.rx_no_slot);
+		airoha_ppe_l2b_dbg_record(ppe, skb, hash, reason, 0, 0,
+					  AIROHA_FOE_STATE_INVALID, 0,
+					  AIROHA_L2B_REJECT_RANGE);
 		return;
 	}
 
 	spin_lock_bh(&ppe_lock);
-	bridge_slowpath = airoha_ppe_foe_is_bridge_slowpath(ppe, hash);
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (hwe) {
+		ib1 = READ_ONCE(hwe->ib1);
+		/* Raw word at the native L2B ib2 offset (entry offset 44),
+		 * useful even when the slot turned out to be another type.
+		 */
+		ib2 = READ_ONCE(hwe->l2b.ib2);
+		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1);
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, ib1);
+	}
 	spin_unlock_bh(&ppe_lock);
 
-	if (!bridge_slowpath) {
+	if (!hwe) {
+		airoha_ppe_fdb_stat_inc(&ppe->fdb_stats.rx_no_slot);
+		airoha_ppe_l2b_dbg_record(ppe, skb, hash, reason, 0, 0,
+					  AIROHA_FOE_STATE_INVALID, 0,
+					  AIROHA_L2B_REJECT_NO_ENTRY);
+		return;
+	}
+
+	if (state == AIROHA_FOE_STATE_BIND) {
 		airoha_ppe_fdb_stat_inc(&ppe->fdb_stats.rx_no_slot);
+		airoha_ppe_l2b_dbg_record(ppe, skb, hash, reason, ib1, ib2,
+					  state, type, AIROHA_L2B_REJECT_BIND);
+		return;
+	}
+
+	if (type != PPE_PKT_TYPE_BRIDGE) {
+		airoha_ppe_fdb_stat_inc(&ppe->fdb_stats.rx_no_slot);
+		airoha_ppe_l2b_dbg_record(ppe, skb, hash, reason, ib1, ib2,
+					  state, type, AIROHA_L2B_REJECT_TYPE);
 		return;
 	}
 
@@ -2529,6 +2641,11 @@
 	rcu_assign_pointer(eth->npu, npu);
 	synchronize_rcu();
 
+	/* One-shot read-only snapshot of the registers that decide whether
+	 * the hardware leaves an unbound L2B entry for the slow path.
+	 */
+	airoha_ppe_l2b_dbg_log_config(ppe);
+
 	return 0;
 
 error_npu_put:
@@ -2754,6 +2871,9 @@
 	if (err)
 		goto error_l2_flow_table_destroy;
 
+	spin_lock_init(&ppe->l2b_dbg.lock);
+	ppe->l2b_dbg.count = 0;
+
 	INIT_WORK(&ppe->npu_attach_work, airoha_ppe_npu_attach_work);
 
 	err = airoha_ppe_debugfs_init(ppe);
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
