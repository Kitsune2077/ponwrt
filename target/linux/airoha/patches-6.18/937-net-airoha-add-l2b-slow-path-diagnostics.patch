+		seq_printf(m, "ppe%u_hash_cfg: %08x hash_seed=%08x\n", i,
+			   airoha_fe_rr(eth, REG_PPE_TB_HASH_CFG(i)),
+			   airoha_fe_rr(eth, REG_PPE_HASH_SEED(i)));
 		seq_printf(m, "ppe%u_gdm2_default_cpu_port: %u\n", i,
