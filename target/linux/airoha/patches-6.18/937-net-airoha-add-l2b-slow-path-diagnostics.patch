 	}
@@ -231,6 +251,83 @@
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_config);
 
+static const char *airoha_ppe_l2b_reject_str(u32 reject)
+{
+	switch (reject) {
+	case AIROHA_L2B_REJECT_RANGE:
+		return "RANGE";
+	case AIROHA_L2B_REJECT_NO_ENTRY:
+		return "NO_ENTRY";
+	case AIROHA_L2B_REJECT_BIND:
+		return "BIND";
+	case AIROHA_L2B_REJECT_TYPE:
+		return "TYPE";
+	default:
+		return "UNKNOWN";
+	}
+}
+
+/* Diagnostic snapshot of the bridge RX slow path. Reads the fixed ring filled
+ * by airoha_ppe_l2b_dbg_record() and the per-reason histogram. Nothing here
+ * touches the PPE, so the file is safe to read while traffic is running.
+ */
+static int airoha_ppe_debugfs_l2b_dbg_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_ppe_l2b_dbg *ring;
+	unsigned long flags;
+	unsigned int count, i;
+
+	ring = kcalloc(AIROHA_PPE_L2B_DBG_MAX, sizeof(*ring), GFP_KERNEL);
+	if (!ring)
+		return -ENOMEM;
+
+	spin_lock_irqsave(&ppe->l2b_dbg.lock, flags);
+	count = ppe->l2b_dbg.count;
+	memcpy(ring, ppe->l2b_dbg.entry, count * sizeof(*ring));
+	spin_unlock_irqrestore(&ppe->l2b_dbg.lock, flags);
+
+	seq_printf(m, "recorded: %u / %u\n", count, AIROHA_PPE_L2B_DBG_MAX);
+	seq_printf(m, "fdb_rx_no_flow: %lu fdb_rx_no_slot: %lu fdb_promoted: %lu\n",
+		   ppe->fdb_stats.rx_no_flow, ppe->fdb_stats.rx_no_slot,
+		   ppe->fdb_stats.promoted);
+
+	for (i = 0; i < ARRAY_SIZE(ppe->rx_reason_count); i++)
+		seq_printf(m, "reason[0x%02x]: %llu\n", i,
+			   (unsigned long long)atomic64_read(&ppe->rx_reason_count[i]));
+
+	seq_puts(m, "idx ifindex hash reason ib1 ib2@44 state type bridge reject jiffies\n");
+	for (i = 0; i < count; i++) {
+		const struct airoha_ppe_l2b_dbg *e = &ring[i];
+
+		seq_printf(m, "%02u %u %04x %02x %08x %08x %u %u %u %s %lu\n",
+			   i, e->ifindex, e->hash, e->reason, e->ib1, e->ib2,
+			   e->state, e->type,
+			   e->type == PPE_PKT_TYPE_BRIDGE,
+			   airoha_ppe_l2b_reject_str(e->reject), e->jiffies);
+	}
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		u32 unbind_age = airoha_fe_rr(eth, REG_PPE_UNBIND_AGE(i));
+		u32 bind_rate = airoha_fe_rr(eth, REG_PPE_BIND_RATE(i));
+
+		seq_printf(m, "ppe%u_unbind_age: %08x min_packets=%u delta=%u driver_writes=0\n",
+			   i, unbind_age,
+			   (u32)FIELD_GET(PPE_UNBIND_AGE_MIN_PACKETS_MASK, unbind_age),
+			   (u32)FIELD_GET(PPE_UNBIND_AGE_DELTA_MASK, unbind_age));
+		seq_printf(m, "ppe%u_bind_rate: %08x l2b_bind=%u bind=%u\n",
+			   i, bind_rate,
+			   (u32)FIELD_GET(PPE_BIND_RATE_L2B_BIND_MASK, bind_rate),
+			   (u32)FIELD_GET(PPE_BIND_RATE_BIND_MASK, bind_rate));
+	}
+
+	kfree(ring);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_l2b_dbg);
+
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 {
 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
@@ -240,6 +337,8 @@
 			    &airoha_ppe_debugfs_foe_all_fops);
 	debugfs_create_file("bind", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_foe_bind_fops);
+	debugfs_create_file("l2b_dbg", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_l2b_dbg_fops);
 
 	return 0;
 }
