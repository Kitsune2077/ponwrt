+
+	fdb->egress_member = false;
+	fdb->egress_untagged = false;
+	fdb->egress_pvid = false;
+
+#if IS_REACHABLE(CONFIG_BRIDGE) && IS_REACHABLE(CONFIG_BRIDGE_VLAN_FILTERING)
+	{
+		struct bridge_vlan_info vinfo;
+		struct net_device *master;
