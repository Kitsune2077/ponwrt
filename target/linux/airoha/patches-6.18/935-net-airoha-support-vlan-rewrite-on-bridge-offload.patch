+		}
 
-	return vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED;
+		if (!br_vlan_get_pvid_rcu(fdb->egress, &pvid))
+			fdb->egress_pvid = pvid == fdb->key.vid;
+
+		/* The bridge protocol is a property of the bridge master, not of
+		 * the port. A non-802.1Q protocol cannot be encoded in the FOE
+		 * template used below, so a failed lookup leaves vlan_proto 0.
+		 */
+		master = netdev_master_upper_dev_get_rcu(fdb->egress);
+		if (master && netif_is_bridge_master(master))
+			br_vlan_get_proto(master, &fdb->vlan_proto);
+
+		rcu_read_unlock();
+	}
+#endif
 }
 
 /* Drop the L2 flows promoted from @fdb and invalidate their FOE entries.
@@ -1321,8 +1392,9 @@
 	struct airoha_fdb_key key;
 	struct net_device *egress;
 	struct ethhdr *eh = eth_hdr(skb);
-	bool tagged;
-	u16 vid;
+	bool ingress_tagged, tag_in_packet = false, push = false;
+	bool ingress_8021q = true;
+	u16 vid = 0;
 	int err;
 
 	/* airoha_ppe_foe_commit_entry() returns -ENODEV until the NPU has been
@@ -1331,7 +1403,7 @@
 	 * yet: leave the frame to the software bridge and count it.
 	 */
 	if (!rcu_access_pointer(ppe->eth->npu)) {
-		WRITE_ONCE(ppe->fdb_stats.no_npu, ppe->fdb_stats.no_npu + 1);
+		airoha_ppe_fdb_stat_inc(&ppe->fdb_stats.no_npu);
 		return;
 	}
 
@@ -1345,36 +1417,57 @@
 	 * classified into the PVID of its ingress bridge port (0 when the port
 	 * is not a VLAN-filtering bridge port); a tagged frame carries its own
